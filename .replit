modules = ["nodejs-24", "postgresql-16"]

# NOTE: artifacts/api-server and artifacts/mockup-sandbox were retired per
# ADR-009 (canonical runtime). They are archived under archive/retired-packages/
# and are no longer Replit artifacts or pnpm workspace members.

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
