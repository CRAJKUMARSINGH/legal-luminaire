{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict":          true,
    "skipLibCheck":    true,
    "outDir":          "./dist",
    "rootDir":         "."
  },
  "include": [
    "research_daemon.ts",
    "phase2_improvement_pipeline.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
