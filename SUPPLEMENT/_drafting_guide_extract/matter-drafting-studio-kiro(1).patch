+              </label>
+              <div className="mt-4 flex flex-wrap gap-2">
+                <button type="button" onClick={saveState} className="inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-sm font-semibold hover:bg-muted"><Save className="h-4 w-4" /> Save & resume {savedAt && `(${savedAt})`}</button>
