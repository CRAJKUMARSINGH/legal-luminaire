  "lineage_templates": {
    "header_format": "DERIVATIVE DRAFT — Lineage Audit\nGenerated: {generated_at}\nCase ID: {case_id}\nParent Draft: {parent_draft_id} ({parent_type})\nDerivative Type: {derivative_type_id} — {derivative_type_label}\nSubject: {subject_id} — {subject_label}\nSource Anchors: {source_anchors}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n",
    "anchor_format": "§ [{anchor_id}] {anchor_ref} — {anchor_summary}\n    → Extractive basis: pages {page_refs}\n    → Transform strategy: {transform_strategy}\n",
    "footer_disclaimer": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nSYNTHETIC / DEMO OUTPUT — Not a substitute for professional legal advice.\nReview every statement against case record and current statute text before filing.\n/ संश्लेषित / डेमो आउटपुट — व्यावसायिक सलाह का विकल्प नहीं है।\nदाखिल करने से पहले प्रत्येक कथन को मामले के रिकॉर्ड और वर्तमान विधि-पाठ के साथ सत्यापित करें।\n"
  },
  "transform_strategies": {
    "rejoinder": "Admit-deny-avoid structure; paragraph-by-paragraph traverse of reply; every controverted fact carries source_anchor to pleadings or evidence record.",
    "counter_claim": "Independent cause-of-action framing; separate cause-title and relief block; mirror pleading standards of original plaint/complaint.",
    "written_submissions": "Issues-framed driven structure; each issue = proposition + authorities + fact matrix; conclusions tied to relief prayer of parent draft.",
    "supplementary_affidavit": "Chronologically numbered paragraphs; each new fact accompanied by newly exhibited document; explicit 'does not contradict parent affidavit' recital.",
    "evidence_application": "List format — exhibit index + mode-of-proof note + relevance-to-issue mapping; RTI / summons request blocks appended.",
    "cross_exam_questions": "Witness-wise grouping; funnel structure (broad → specific); impeachment questions tagged to prior statement anchors; suggested answers as [Expected: …].",
    "objection_docs": "Document-wise objection blocks; each = ground (hearsay / relevance / mode-of-proof / forged) + legal provision + prejudice argument.",
    "appeal_memorial": "Grounds-of-appeal enumeration; each ground = error-of-law + record citation + prejudice + relief-substitution; mirror formatting of lower-court judgment.",
    "stay_application": "Triple test — prima facie case, balance of convenience, irreparable injury; each limb = fact paragraph + parent-extract anchor.",
    "compliance_affidavit": "Condition-by-condition tick-off; each with evidence exhibit + date-of-compliance; concluding 'no further conditions outstanding' declaration.",
    "review_petition": "Restricted to (a) error apparent on face (b) new/important matter not previously available; each head = specific page/paragraph anchor of impugned order.",
    "execution_petition": "Decree terms breakdown; each relief = execution-mode + resistance-anticipated + interim steps prayed; limitation computation appended."
  }
}
